{
  "productName": "JupyterLab",
  "version": "../package.json",
  "identifier": "rs.jupyterlab.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "csp": null
    },
    "windows": [
      {
        "fullscreen": false,
        "resizable": true,
        "title": "JupyterLab",
        "width": 1000,
        "height": 800,
        "transparent": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "shell": {
      "open": true,
      "scope": [
        {
          "args": true,
          "cmd": "jupyter",
          "name": "jupyter",
          "sidecar": false
        },
        {
          "args": true,
          "cmd": "python",
          "name": "python",
          "sidecar": false
        }
      ]
    },
    "updater": {
      "endpoints": []
    }
  }
}
